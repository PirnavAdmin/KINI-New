                  fill="#FBBC05"
                />
                <path
                  d="M12 23c3.24 0 5.97-1.08 7.96-2.9l-3.6-2.8c-1.1.74-2.5 1.18-4.36 1.18-3.22 0-5.99-2.18-6.96-5.26l-3.6 2.8C3.4 20.35 7.35 23 12 23z"
                  fill="#34A853"
                />
              </svg>
              <span>
