              />
              <path
                d="m6 6 12 12"
              />
            </svg>
          </button>
        </div>
        <div
          class="login-form-shell mx-auto flex w-full max-w-[420px] shrink-0 flex-col justify-start overflow-visible px-5 pb-2 pt-8 sm:px-6 sm:pb-3"
          style="opacity: 0;"
        >
          <div
            class="mb-5 flex items-center gap-2.5 lg:hidden"
