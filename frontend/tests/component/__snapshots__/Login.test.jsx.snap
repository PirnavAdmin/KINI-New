                    d="M5 12h14"
                  />
                  <path
                    d="m12 5 7 7-7 7"
                  />
                </svg>
              </button>
            </div>
          </form>
          <div
            class="login-divider relative my-4"
            style="opacity: 0; transform: translateY(8px);"
          >
            <div
