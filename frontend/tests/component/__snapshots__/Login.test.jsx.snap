                  >
                    <path
                      d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"
                    />
                    <circle
                      cx="12"
                      cy="12"
                      r="3"
                    />
                  </svg>
                </button>
              </div>
            </div>
            <div
              class="login-remember flex items-center pt-1"
              style="opacity: 0; transform: translateY(8px);"
            >
              <input
                class="h-4 w-4 cursor-pointer rounded border-gray-300 text-blue-600 accent-blue-600 focus:ring-2 focus:ring-blue-500 dark:border-slate-600"
                id="remember_me"
                type="checkbox"
              />
              <label
                class="ml-2 block cursor-pointer text-sm font-medium text-slate-600 dark:text-slate-300"
                for="remember_me"
              >
                Remember me for 30 days
              </label>
            </div>
            <div
              class="pt-0.5"
              style="opacity: 0; transform: translateY(8px);"
            >
              <button
                class="login-control group flex h-[clamp(44px,6.5vh,52px)] w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#0f55f7] to-[#06b6a8] px-4 text-sm font-bold text-white shadow-[0_10px_24px_rgba(15,85,247,.25)] transition-all hover:-translate-y-0.5 hover:brightness-105 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-blue-300 active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none"
                type="submit"
              >
                <span>
