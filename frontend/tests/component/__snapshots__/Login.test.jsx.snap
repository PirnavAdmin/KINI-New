                <svg
                  aria-hidden="true"
                  class="lucide lucide-arrow-right h-[18px] w-[18px] transition-transform duration-200 group-hover:translate-x-1"
                  fill="none"
                  height="24"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="24"
