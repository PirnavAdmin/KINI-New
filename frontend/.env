# Jitsi Meet deployment used for embedded live-class video. meet.jit.si is the
# public instance and is fine for testing, but Jitsi's own docs say it isn't
# intended for production use — point this at Jitsi as a Service or a
# self-hosted deployment before going live.
VITE_JITSI_DOMAIN=meet.jit.si
 
